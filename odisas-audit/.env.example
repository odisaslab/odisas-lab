# ── Obligatoria ────────────────────────────────────────────────────────
# Texto largo y aleatorio. Firma los datos del análisis para que el email
# solo pueda contener lo que ha generado el servidor. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUDIT_SECRET=

# ── Envío de emails: elige UNA opción ─────────────────────────────────
# Opción A · Gmail con contraseña de aplicación (la más rápida).
# Cuenta de Google → Seguridad → Verificación en 2 pasos → Contraseñas de aplicaciones.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Opción B · Resend con dominio propio (mejor entregabilidad, más envíos).
RESEND_API_KEY=
MAIL_FROM=

# ── Recomendadas ───────────────────────────────────────────────────────
# Enlace de Calendly o Google Calendar para el botón "Agendar una llamada".
# Sin él, el botón del email abre un correo de respuesta en su lugar.
MEETING_URL=

# Clave gratuita de Google PageSpeed Insights API (para la categoría de
# rendimiento). Sin ella esa categoría se muestra como "No disponible".
PAGESPEED_API_KEY=

# ── Opcionales ─────────────────────────────────────────────────────────
SENDER_NAME=Alejandro
REPLY_TO_EMAIL=Odisaslab@gmail.com
CONTACT_PHONE=616 88 00 63
INTERNAL_COPY_EMAIL=
PUBLIC_BASE_URL=

# ── Solo desarrollo local ──────────────────────────────────────────────
# Si no configuras SMTP ni Resend, los emails se guardan aquí como archivos
# en vez de enviarse, para poder revisarlos.
MAIL_DEV_OUTBOX=./outbox
