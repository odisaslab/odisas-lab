# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://odisaslab.com

# Contacto directo. Si se deja vacío, se usa el valor por defecto de data/site.ts.
NEXT_PUBLIC_CONTACT_EMAIL=Odisaslab@gmail.com
NEXT_PUBLIC_PHONE=+34616880063
NEXT_PUBLIC_PHONE_DISPLAY=616 88 00 63
NEXT_PUBLIC_WHATSAPP=+34616880063

# Redes: rellenar cuando existan los perfiles. Vacío = no se muestra el enlace.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=

# Analítica: dejar vacío hasta tener los IDs reales (no usar IDs ficticios).
# Nada se carga hasta que el usuario acepta la categoría correspondiente en el
# banner de cookies. Si hay GTM_ID, se usa GTM y se ignora GA_ID.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Entrega del formulario de contacto ────────────────────────────────
# Opción A (la más rápida): webhook de Zapier, Make, n8n o tu CRM.
CONTACT_WEBHOOK_URL=

# Opción B: email con Resend (https://resend.com). Requiere dominio verificado.
RESEND_API_KEY=
CONTACT_TO_EMAIL=Odisaslab@gmail.com
CONTACT_FROM_EMAIL=

# Sin ninguna de las dos opciones, el formulario avisa al usuario y ofrece
# contacto directo, y la solicitud queda registrada en el log del servidor.

# ── Diagnóstico web gratuito (/analiza-tu-web y sección de la home) ───
# El análisis funciona sin configurar nada. Esto mejora o activa piezas concretas:

# Clave gratuita de Google PageSpeed Insights API (sin ella Google limita las consultas).
PAGESPEED_API_KEY=

# Texto largo y aleatorio que firma los datos del email. Si se deja vacío se deriva
# de otra credencial ya configurada (RESEND_API_KEY, SMTP_PASS o CONTACT_WEBHOOK_URL).
AUDIT_SECRET=

# Envío del informe al cliente (y de los avisos al equipo). Elige UNA opción:
#  A) SMTP, p. ej. Gmail con contraseña de aplicación:
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
#  B) Resend (ya declarado arriba): RESEND_API_KEY + MAIL_FROM (o CONTACT_FROM_EMAIL)
MAIL_FROM=
# Enlace de Calendly o Google Calendar para el botón "Agendar una llamada" del email.
MEETING_URL=
# Firma del email (por defecto "El equipo de Odisas Lab") y copia oculta opcional.
SENDER_NAME=
INTERNAL_COPY_EMAIL=
# Solo desarrollo: guarda los emails en esta carpeta en lugar de enviarlos.
MAIL_DEV_OUTBOX=
# Solo pruebas locales: permite analizar localhost.
ALLOW_PRIVATE_HOSTS=
